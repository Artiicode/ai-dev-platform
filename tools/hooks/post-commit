#!/usr/bin/env bash
# If an AI trailer landed on HEAD after commit-msg (IDE inject/amend), strip it.
set -euo pipefail

msg="$(git log -1 --format=%B 2>/dev/null || true)"
[ -n "$msg" ] || exit 0

if ! printf '%s\n' "$msg" | grep -Eiq '^[[:space:]]*(Co-Authored-By|Co-authored-by|Made-with|Made-With)[[:space:]]*:' \
  && ! printf '%s\n' "$msg" | grep -Eiq '^[[:space:]]*Generated with[[:space:]]+'; then
  exit 0
fi

# Never rewrite a commit that upstream already has.
if git rev-parse '@{u}' >/dev/null 2>&1; then
  if git merge-base --is-ancestor HEAD '@{u}' 2>/dev/null; then
    echo "[post-commit] AI trailer on pushed HEAD — strip manually (not amending)." >&2
    exit 0
  fi
fi

tmp="$(mktemp)"
printf '%s\n' "$msg" | python3 -c '
import re, sys
pat = re.compile(
    r"^\s*(Co-Authored-By|Co-authored-by|Made-with|Made-With)\s*:"
    r"|^\s*Generated with\s+",
    re.I,
)
lines = sys.stdin.read().splitlines(keepends=True)
kept = [ln for ln in lines if not pat.search(ln)]
while kept and kept[-1].strip() == "":
    kept.pop()
sys.stdout.write("".join(kept))
if kept and not kept[-1].endswith("\n"):
    sys.stdout.write("\n")
' > "$tmp"

GIT_EDITOR=true git commit --amend -F "$tmp" --no-verify >/dev/null
rm -f "$tmp"
echo "[post-commit] stripped AI/tool attribution trailer from HEAD" >&2
exit 0
