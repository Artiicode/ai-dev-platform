{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "info-index.schema.json",
  "title": "Info Index (provenance + routing)",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "store", "source", "sha256", "ingested_at"],
        "properties": {
          "id": { "type": "string" },
          "store": { "enum": ["md", "sql", "vector"] },
          "location": { "type": "string", "description": "info/ 내 산출물 경로 또는 테이블/컬렉션명" },
          "source": { "type": "string", "description": "archives/ 내 원본 경로" },
          "sha256": { "type": "string" },
          "ingested_at": { "type": "string", "format": "date-time" },
          "tool": { "type": "string" },
          "supersedes": { "type": "array", "items": { "type": "string" } },
          "route": { "enum": ["sql", "rag", "wiki"], "description": "의미적 라우팅 결정" },
          "route_by": { "type": "string", "description": "결정 근거: hint|classifier|fallback" }
        }
      }
    }
  }
}
