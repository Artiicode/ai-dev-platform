# 모델/임베딩 (platform/models/models.yaml 도 참조)
# 모델 키는 models.yaml 의 api_key_env 이름에 맞춰 설정 (예: ANTHROPIC_API_KEY=..., OPENAI_API_KEY=...)
HARNESS_EMBED_BACKEND=local      # local(bge-m3) | hash(오프라인/테스트)
HARNESS_EMBED_MODEL=BAAI/bge-m3
HARNESS_MCP_TRANSPORT=stdio      # stdio | sse | streamable-http(웹 GUI)
