# 모델/임베딩 (platform/models/models.yaml 도 참조)
# 모델 키는 models.yaml 의 api_key_env 이름에 맞춰 설정 (예: ANTHROPIC_API_KEY=..., OPENAI_API_KEY=...)
HARNESS_EMBED_BACKEND=local      # local(bge-m3 기본) | hash(오프라인/테스트)
HARNESS_EMBED_MODEL=BAAI/bge-m3
HARNESS_MCP_TRANSPORT=stdio      # stdio | sse | streamable-http(웹 GUI)

# 외부 MCP 자격증명 (platform/mcp-servers.yaml 의 enabled 서버가 필요로 하는 키).
# `harness mcp` 로 붙인 외부 서버는 mcp_launch.py 가 .env 를 자동 주입한다(export 불필요).
# 값에 # 나 공백이 있으면 따옴표로 감싸세요.  필요한 것만 주석 해제해 채우기:
# JIRA_URL=https://your.atlassian.net
# JIRA_API_TOKEN=...
# FIGMA_API_KEY=...
# BITBUCKET_USERNAME=...
# BITBUCKET_APP_PASSWORD=...
